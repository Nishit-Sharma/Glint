{
  "name": "window-companion",
  "version": "0.4.10-dev.20261026",
  "private": true,
  "description": "Local window-aware desktop companion",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-document-source.mjs && tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --dir",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.77",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "ai": "7.0.151",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "effect": "3.22.4",
    "get-windows": "9.3.0",
    "lucide-react": "0.577.0",
    "marked": "18.1.1",
    "motion": "12.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.6.0",
    "uiohook-napi": "1.5.5",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "local.nishit.windowcompanion",
    "productName": "Window Companion",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/companion.icns"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "**/*.node",
      "out/native/document-source",
      "out/native/mac-window-at-point"
    ]
  },
  "overrides": {
    "tar": "7.5.22",
    "esbuild": "0.28.2"
  }
}
